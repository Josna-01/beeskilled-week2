# Server Configuration
PORT=5003

# MongoDB Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/notes_app_db
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/notes_app_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/notes_app_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
